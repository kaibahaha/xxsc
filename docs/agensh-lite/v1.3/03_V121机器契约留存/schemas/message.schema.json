{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGL_LITE_V1_2_1_MESSAGE",
  "description": "每源流单生产者递增seq；每收件人独立处理和ACK",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "AGL_LITE_V1_2_1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "sender": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"
      }
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "stream_seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "delivery_status": {
      "const": "COMMITTED"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_version",
    "created_at_utc",
    "message_id",
    "event_id",
    "task_id",
    "sender",
    "recipients",
    "stream_id",
    "stream_seq",
    "payload_ref",
    "idempotency_key",
    "delivery_status"
  ]
}
