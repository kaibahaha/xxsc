{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGL_LITE_V1_2_1_RUN",
  "description": "调度是真实唤醒，标记未知和日志证据，不把创建任务当执行",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "AGL_LITE_V1_2_1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"
    },
    "runtime": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"
    },
    "invocation_mode": {
      "enum": [
        "MANUAL",
        "SCHEDULED",
        "WORK",
        "CI"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "enum": [
        "STARTED",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "observed_repo": {
      "type": "string",
      "minLength": 3
    },
    "observed_ref": {
      "type": "string",
      "minLength": 3
    },
    "observed_base_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "registry_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "observed_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "log_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_version",
    "created_at_utc",
    "run_id",
    "agent_id",
    "runtime",
    "invocation_mode",
    "started_at_utc",
    "status",
    "observed_repo",
    "observed_ref",
    "observed_base_sha",
    "registry_sha",
    "observed_capabilities",
    "log_ref"
  ]
}
