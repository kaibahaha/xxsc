{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGL_LITE_V1_2_1_ACK",
  "description": "每收件人独立不可变ACK；不是业务验收或Git目标侧交付回执",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "AGL_LITE_V1_2_1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ack_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "recipient_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "stream_seq": {
      "type": "integer",
      "minimum": 1
    },
    "ack_type": {
      "enum": [
        "SEEN_ACK",
        "PROCESSED_ACK",
        "BLOCKED_ACK"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_version",
    "created_at_utc",
    "ack_id",
    "message_id",
    "source_event_id",
    "recipient_id",
    "stream_id",
    "stream_seq",
    "ack_type",
    "operation_id",
    "evidence_ref",
    "idempotency_key"
  ]
}
