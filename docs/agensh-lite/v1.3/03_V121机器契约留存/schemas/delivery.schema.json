{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGL_LITE_V1_2_1_DELIVERY",
  "description": "V1.2.1：VERIFIED要求回读SHA与比较基准；真实目标存在、源目标一致仍需Runtime验证。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "AGL_LITE_V1_2_1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "target": {
      "enum": [
        "GIT",
        "DRIVE",
        "LIBRARY"
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "INTENT_RECORDED",
        "WRITE_ATTEMPTED",
        "VERIFIED",
        "UNKNOWN",
        "CONFLICT",
        "BLOCKED"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "destination_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "readback_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "hash_basis": {
      "enum": [
        "RAW_BYTES_SHA256",
        "CANONICAL_TEXT_SHA256"
      ]
    },
    "comparison_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "readback_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024
    },
    "readback_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_version",
    "created_at_utc",
    "delivery_id",
    "artifact_id",
    "target",
    "status",
    "operation_id",
    "source_hash",
    "destination_ref",
    "evidence_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "readback_hash",
          "comparison_hash",
          "hash_basis",
          "readback_ref",
          "readback_at_utc"
        ],
        "properties": {
          "readback_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
