{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGL_LITE_V1_2_1_TASK",
  "description": "统一任务对象；业务状态不包含消息或复制状态",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "AGL_LITE_V1_2_1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
    },
    "task_type": {
      "enum": [
        "EXPLORATION",
        "IMPLEMENTATION",
        "QA",
        "INTEGRATION",
        "OPERATIONS",
        "RESEARCH"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "READY",
        "CLAIMED",
        "IMPLEMENTING",
        "SELF_TESTED",
        "REVIEW_PENDING",
        "REVIEW_APPROVED",
        "INTEGRATION_PENDING",
        "INTEGRATION_FAILED",
        "ACCEPTED",
        "BLOCKED",
        "QUARANTINED"
      ]
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{2,100}$"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_version",
    "created_at_utc",
    "task_id",
    "task_type",
    "status",
    "spec_hash",
    "dependencies",
    "acceptance_criteria",
    "allowed_paths",
    "attempt_epoch",
    "risk"
  ]
}
