{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenshLiteNote",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "event_id",
    "project_id",
    "task_id",
    "producer",
    "summary",
    "evidence_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "FACT",
        "OBSERVED",
        "FAIL",
        "CLAIM",
        "PATCH_SUMMARY"
      ]
    },
    "event_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 320
    },
    "detail_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "affected_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "spec_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
