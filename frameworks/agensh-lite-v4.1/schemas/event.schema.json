{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenshLiteEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "project_id",
    "task_id",
    "producer",
    "target_agents",
    "kind",
    "source",
    "observed_at",
    "summary",
    "raw_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "target_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "raw_ref": {
      "type": "string"
    },
    "payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
