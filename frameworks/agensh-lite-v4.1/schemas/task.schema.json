{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenshLiteTask",
  "type": "object",
  "required": [
    "project_id",
    "task_id",
    "status",
    "spec_hash",
    "revision",
    "acceptance_criteria"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "spec_hash": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
